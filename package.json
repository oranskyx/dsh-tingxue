{
  "name": "dsh-tingxue",
  "version": "0.2.0",
  "description": "听雪 · 独立 IM bot 插件：人格注入 + 自建 LanceDB 向量记忆库 + 实体关系图谱。消息收发全部交给 @xmanrui/dsh-im，本插件只做「装配」和「记忆」，两个 QQ bot 分别承担陪伴与干活两种上下文。",
  "type": "module",
  "main": "src/im-bot/index.mjs",
  "exports": {
    ".": "./src/im-bot/index.mjs",
    "./client": "./client/panel.js",
    "./icon": "./client/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "client",
    "src",
    "service/memory-service.mjs",
    "service/config.example.json",
    "service/bin/nssm.exe",
    "service/install-nssm.ps1",
    "service/uninstall-nssm.ps1",
    "examples",
    "scripts/selfcheck.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "selfcheck": "node scripts/selfcheck.mjs",
    "test": "node scripts/run-tests.mjs",
    "install-check": "node scripts/install-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@xmanrui/dsh-im": ">=5.0.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@xmanrui/dsh-im": {
      "optional": true
    }
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.37.1",
    "apache-arrow": "18.1.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "vector-database",
    "lancedb",
    "chatbot",
    "virtual-life",
    "qq",
    "astrbot"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "DSH and oransky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oranskyx/dsh-tingxue.git"
  },
  "bugs": {
    "url": "https://github.com/oranskyx/dsh-tingxue/issues"
  },
  "homepage": "https://github.com/oranskyx/dsh-tingxue#readme"
}
